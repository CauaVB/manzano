Algoritmo "CalcularDiferença"
// 
//  
// Descrição   : Ler dois inteiros (variáveis A e B)
//e imprimir o resultado do quadrado da diferença do primeiro valor pelo
//segundo.

// Autor(a)    : Cauã Vasco Bissoli
// Data atual  : 15/09/2026
Var
// Seção de Declarações das variáveis 
a, b : inteiro
resultado : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Digite a")
leia(a)

escreval("Digite b")
leia(b)

resultado <- (a - b)*2(a - b)

escreval("diferença dos dois:", resultado)

Fimalgoritmo