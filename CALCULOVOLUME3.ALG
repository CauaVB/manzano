Algoritmo "CalculoVolume"
// 
//  
// Descrição   : Calcular e apresentar o valor do volume de
//uma lata de óleo, utilizando a fórmula:
// Volume *Raio * Altura
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 27/09/2026
Var
// Seção de Declarações das variáveis 
raio, volume, altura : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Digite raio")
leia(raio)

escreval("Digite altura")
leia(altura)

      volume <- raio * altura
      
escreval("o volume da late é:", volume)

Fimalgoritmo