Algoritmo "Distributiva"
// 
//  
// Descrição   : Ler quatro números inteiros e apresentar o resultado da adição e multiplicação, baseando-se na
//utilização do conceito da propriedade distributiva
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 27/09/2026
Var
// Seção de Declarações das variáveis 
va, vb, vc, vd : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval("Digite O valor a:")
leia(va)

Escreval("Digite O valor b:")
leia(vb)

Escreval("Digite O valor c:")
leia(vc)

Escreval("Digite O valor d:")
leia(vd)

escreval("Resultados da Adição:")
escreval("A + B = ", va + vb)
escreval("A + C = ", va + vc)
escreval("A + D = ", va + vd)
escreval("B + C = ", vb + vc)
escreval("B + D = ", vb + vd)
escreval("C + D = ", vc + vd)

escreval("-----------------------")

// Resultados das 6 operações de multiplicação
escreval("Resultados da Multiplicação:")
escreval("A * B = ", va * vb)
escreval("A * C = ", va * vc)
escreval("A * D = ", va * vd)
escreval("B * C = ", vb * vc)
escreval("B * D = ", vb * vd)
escreval("C * D = ", vc * vd)

Fimalgoritmo